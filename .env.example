# Codex Dispatch runtime configuration
# Copy values into the systemd EnvironmentFile used for deployment.

# Logging
CODEX_DISPATCH_LOG_LEVEL=INFO

# Persistent SQLite database. Use an absolute path.
CODEX_DISPATCH_DB_PATH=/var/lib/codex-dispatch/codex-dispatch.db

# Colon-separated absolute project roots Codex Dispatch may control.
# Never allow the whole home directory: it may contain .codex, .ssh, the Codex
# executable, or this orchestrator itself. List only the repositories/workspaces
# that should be remotely controllable.
CODEX_ALLOWED_ROOTS=/home/your-user/project-a:/home/your-user/project-b

# Live Codex queue integration (PHASE 6).
# Prefer an absolute binary path for systemd if the npm global bin directory is not
# guaranteed to be present in the service PATH.
CODEX_DISPATCH_CODEX_BIN=codex
CODEX_DISPATCH_CODEX_QUEUE_TIMEOUT_SECONDS=10
CODEX_DISPATCH_CODEX_CAPABILITY_TIMEOUT_SECONDS=5
CODEX_DISPATCH_CODEX_PROMPT_MAX_CHARS=8000

# Managed/headless `codex exec resume` policy.
# Prompt text is sent over stdin and never added to argv by Codex Dispatch.
CODEX_DISPATCH_MANAGED_TIMEOUT_SECONDS=21600
CODEX_DISPATCH_MANAGED_OUTPUT_MAX_BYTES=262144

# Local Codex external-notify bridge.
# Leave CODEX_DISPATCH_NOTIFY_SOCKET unset to use
# $XDG_RUNTIME_DIR/codex-dispatch/notify.sock or /run/user/<uid>/codex-dispatch/notify.sock.
CODEX_DISPATCH_NOTIFY_SOCKET=
CODEX_DISPATCH_NOTIFY_MAX_BYTES=262144
CODEX_DISPATCH_NOTIFY_TIMEOUT_SECONDS=0.75

# Discord credentials and fail-closed authorization allowlists.
# Required by the PHASE 2+ service. Channel IDs may be parent channels; their
# Discord Threads are authorized through the parent-channel relationship.
DISCORD_BOT_TOKEN=
# Parent channel where PHASE 4 creates one Discord Thread per Codex session.
# This ID must also appear in DISCORD_ALLOWED_CHANNEL_IDS.
DISCORD_CONTROL_CHANNEL_ID=
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_ALLOWED_USER_IDS=

# Completion delivery retry policy. Retries apply only to confirmed send failures.
CODEX_DISPATCH_DISCORD_RETRY_ATTEMPTS=3
CODEX_DISPATCH_DISCORD_RETRY_BASE_SECONDS=0.5
