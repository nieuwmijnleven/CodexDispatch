# Codex Dispatch systemd environment file.
# The installer renders the CODEX_BIN default but never writes secrets or workspace roots.

CODEX_DISPATCH_LOG_LEVEL=INFO
CODEX_DISPATCH_DB_PATH=/var/lib/codex-dispatch/codex-dispatch.db
# REQUIRED: colon-separated exact repositories/workspaces. Do not use @SERVICE_HOME@
# itself because that would expose .codex/.ssh, this service source, and user binaries.
CODEX_ALLOWED_ROOTS=

CODEX_DISPATCH_CODEX_BIN=@CODEX_BIN@
CODEX_DISPATCH_CODEX_QUEUE_TIMEOUT_SECONDS=10
CODEX_DISPATCH_CODEX_CAPABILITY_TIMEOUT_SECONDS=5
CODEX_DISPATCH_CODEX_PROMPT_MAX_CHARS=8000
CODEX_DISPATCH_MANAGED_TIMEOUT_SECONDS=21600
CODEX_DISPATCH_MANAGED_OUTPUT_MAX_BYTES=262144

DISCORD_CONTROL_CHANNEL_ID=
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_ALLOWED_USER_IDS=

CODEX_DISPATCH_DISCORD_RETRY_ATTEMPTS=3
CODEX_DISPATCH_DISCORD_RETRY_BASE_SECONDS=0.5
