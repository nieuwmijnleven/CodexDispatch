# Non-secret settings shared by the systemd service and interactive Codex notify client.
# This file is intentionally safe for the Codex service user to read.

CODEX_DISPATCH_NOTIFY_SOCKET=/run/codex-dispatch/notify.sock
CODEX_DISPATCH_NOTIFY_MAX_BYTES=262144
CODEX_DISPATCH_NOTIFY_TIMEOUT_SECONDS=0.75
